[
  {
    "id": "deploy",
    "execute-command": "/opt/mgdrywallusa-website/scripts/webhook-bridge.sh",
    "command-working-directory": "/opt/mgdrywallusa-website",
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "value",
            "value": "__WEBHOOK_TOKEN__",
            "parameter": {
              "source": "header",
              "name": "X-Webhook-Token"
            }
          }
        }
      ]
    }
  }
]
