# Single source of truth for the deploy health-check contract (US-009).
# Consumed by scripts/deploy.sh and enforced by
# backend/tests/core/test_health_contract.py, which also asserts that the
# compose healthchecks and the Django URLconf agree with these values.
# Changing anything here must keep all three in sync (the test fails CI
# otherwise).
HEALTHCHECK_PATH=/api/v1/pages/
HEALTHCHECK_PROTO=https
