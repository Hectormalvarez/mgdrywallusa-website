# Django
DJANGO_SECRET_KEY=replace-with-64-char-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,mgdrywallusa.com,www.mgdrywallusa.com
CSRF_TRUSTED_ORIGINS=http://localhost:8101

# PostgreSQL
DB_NAME=mgdrywall
DB_USER=mgdrywall
DB_PASSWORD=replace-with-strong-password
DB_HOST=db
DB_PORT=5432

# Single public origin (Nginx reverse proxy)
FRONTEND_URL=http://localhost:8101
WAGTAIL_PREVIEW_URL=http://localhost:8101/api/preview
WAGTAILADMIN_BASE_URL=http://localhost:8101

# Public API URLs (browser-facing, through Nginx)
NEXT_PUBLIC_LEAD_API_URL=http://localhost:8101/api/v1/leads/
NEXT_PUBLIC_WAGTAIL_API_URL=http://localhost:8101/api/v1/pages/?type=portfolio.PortfolioItem&fields=*

# Internal Docker DNS (SSR/API calls from frontend container to backend)
WAGTAIL_API_BASE_URL=http://backend:8000/api/v1

# Host port overrides (optional)
POSTGRES_HOST_PORT=5432
NGINX_HOST_PORT=8101

