# ── Django ──────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-64-char-random-string
DEBUG=False
ALLOWED_HOSTS=mgdrywallusa-dev.taylormadetech.net,localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=https://mgdrywallusa-dev.taylormadetech.net

# ── PostgreSQL ──────────────────────────────────────────────────
DB_NAME=mgdrywall
DB_USER=mgdrywall
DB_PASSWORD=replace-with-strong-password
DB_HOST=db
DB_PORT=5432

# ── Single public origin (Cloudflare Tunnel → Nginx → stack) ───
FRONTEND_URL=https://mgdrywallusa-dev.taylormadetech.net
WAGTAIL_PREVIEW_URL=https://mgdrywallusa-dev.taylormadetech.net/api/preview
WAGTAILADMIN_BASE_URL=https://mgdrywallusa-dev.taylormadetech.net

# ── Public API URLs (browser-facing, relative paths through Nginx) ─
NEXT_PUBLIC_LEAD_API_URL=/api/v1/leads/
NEXT_PUBLIC_WAGTAIL_API_URL=/api/v1/pages/?type=portfolio.PortfolioItem&fields=*

# ── Internal Docker DNS (SSR/API calls from frontend → backend) ─
WAGTAIL_API_BASE_URL=http://backend:8000/api/v1

# ── Host port overrides (optional) ─────────────────────────────
POSTGRES_HOST_PORT=5432
NGINX_HOST_PORT=8101

