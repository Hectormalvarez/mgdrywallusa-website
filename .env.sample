# ── Django ──────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-64-char-random-string
DEBUG=False
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# ── PostgreSQL ──────────────────────────────────────────────────
DB_NAME=mgdrywall
DB_USER=mgdrywall
DB_PASSWORD=replace-with-strong-password
DB_HOST=db
DB_PORT=5432

# ── PostgreSQL (compose interpolation for healthchecks) ─────────
POSTGRES_USER=mgdrywall
POSTGRES_DB=mgdrywall

# ── Public site origin (used by Next.js metadata, robots, sitemap)
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
# SITE_URL=https://your-production-domain.com   # server-only fallback

# ── Allowed dev origins (comma-separated hostnames, for next.config.ts) ──
# Next.js dev server rejects cross-origin requests to /_next/* with 403 unless
# the browser's host is listed. Include the public hostname your tunnel exposes
# the dev stack on (the hostname from NEXT_PUBLIC_SITE_URL is added automatically).
ALLOWED_DEV_ORIGINS=usrv-01,localhost,mgdrywallusa-dev.taylormadetech.net

# ── Frontend API URLs (browser-facing, relative paths via Nginx)
NEXT_PUBLIC_LEAD_API_URL=/api/v1/leads/
NEXT_PUBLIC_WAGTAIL_API_URL=/api/v1/pages/?type=portfolio.PortfolioItem&fields=*

# ── Internal Docker DNS (SSR/API calls from frontend → backend)
WAGTAIL_API_BASE_URL=http://backend:8000/api/v1

# ── URLs derived from public origin (for Django/Wagtail) ────────
FRONTEND_URL=https://your-production-domain.com
WAGTAIL_PREVIEW_URL=https://your-production-domain.com/api/preview
WAGTAILADMIN_BASE_URL=https://your-production-domain.com

# ── Host port overrides (optional, dev compose only) ───────────
POSTGRES_HOST_PORT=5432
NGINX_HOST_PORT=8101

# ── Cloudflare Tunnel (dev + prod containers) ──────────────────
# Dev stack:  set it in .env      → started by `make dev-tunnel-up`
# Prod stack: set it in .env.prod → started by `make prod-deploy`
#
# Use a DIFFERENT tunnel (different token) per environment. Sharing one token
# registers two connectors on the same tunnel and Cloudflare will load-balance
# visitors across the dev and prod stacks.
#
# The tunnel's public hostname must target Nginx by service name:
#   http://nginx:80
CLOUDFLARE_TUNNEL_TOKEN=

# ── Cloudflare API (edge caching, US-008) ────────────────────────
# Zone-scoped API token + zone ID for cache analytics and cache purge.
# Token permissions: Zone → Analytics:Read, Zone → Zone Settings:Read,
# Zone → Cache Purge:Purge. Never commit real values.
# Used by: scripts/cf-cache-stats.sh, the publish-revalidate purge
# (backend container), and the deploy purge in scripts/deploy.sh.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Publish revalidation (edge caching, US-008) ─────────────────
# Shared secret between the Wagtail publish signal (backend) and the
# Next.js /api/revalidate endpoint (frontend). Generate with:
#   openssl rand -hex 32
REVALIDATE_SECRET=

# ── Webhook (production only) ──────────────────────────────────
# Generate with: openssl rand -hex 32
# Must match the WEBHOOK_TOKEN GitHub secret
WEBHOOK_TOKEN=

# ── GHCR image references (production only) ────────────────────
REGISTRY_OWNER=mgdrywall
IMAGE_TAG=latest

# ── Backup (optional, S3/R2 compatible) ────────────────────────
# S3_BACKUP_BUCKET=your-backup-bucket
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=https://your-s3-endpoint.com

